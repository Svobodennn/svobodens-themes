# Svoboden's Themes: Matrix colours for delta (https://github.com/dandavison/delta).
# Generated by extras/make-extras.mjs from themes/matrix.json; change those, not this file.
# Use, in ~/.gitconfig:
#   [include]
#       path = /path/to/extras/matrix/delta.gitconfig
#   [delta]
#       features = matrix
# syntax-theme is the bat theme from bat.tmTheme, installed as svoboden-matrix (delta reads bat's cache).
[delta "matrix"]
    dark = true
    syntax-theme = svoboden-matrix
    minus-style = syntax "#2b120c"
    minus-emph-style = syntax "#591e16"
    plus-style = syntax "#012b02"
    plus-emph-style = syntax "#015201"
    zero-style = syntax
    whitespace-error-style = "#d23c32" reverse
    file-style = "#c1ff75" bold
    file-decoration-style = "#c1ff75" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#2f6b35" box
    hunk-header-file-style = "#3fd9c8"
    hunk-header-line-number-style = "#c1ff75"
    commit-decoration-style = "#c1ff75" box ul
    line-numbers-minus-style = "#d23c32"
    line-numbers-plus-style = "#00cc00"
    line-numbers-zero-style = "#2f6b35"
    line-numbers-left-style = "#1d5c12"
    line-numbers-right-style = "#1d5c12"
