# Svoboden's Themes: Cyberpunk 2077 colours for delta (https://github.com/dandavison/delta).
# Generated by extras/make-extras.mjs from themes/cyberpunk-2077.json; change those, not this file.
# Use, in ~/.gitconfig:
#   [include]
#       path = /path/to/extras/cyberpunk-2077/delta.gitconfig
#   [delta]
#       features = cyberpunk-2077
# syntax-theme is the bat theme from bat.tmTheme, installed as svoboden-cyberpunk-2077 (delta reads bat's cache).
[delta "cyberpunk-2077"]
    dark = true
    syntax-theme = svoboden-cyberpunk-2077
    minus-style = syntax "#3e0e1e"
    minus-emph-style = syntax "#730f25"
    plus-style = syntax "#11362a"
    plus-emph-style = syntax "#146340"
    zero-style = syntax
    whitespace-error-style = "#fe1038" reverse
    file-style = "#fcee0a" bold
    file-decoration-style = "#fcee0a" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#55557a" box
    hunk-header-file-style = "#00f0ff"
    hunk-header-line-number-style = "#fcee0a"
    commit-decoration-style = "#fcee0a" box ul
    line-numbers-minus-style = "#fe1038"
    line-numbers-plus-style = "#1ded83"
    line-numbers-zero-style = "#55557a"
    line-numbers-left-style = "#24484c"
    line-numbers-right-style = "#24484c"
