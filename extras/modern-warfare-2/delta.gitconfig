# Svoboden's Themes: Modern Warfare 2 colours for delta (https://github.com/dandavison/delta).
# Generated by extras/make-extras.mjs from themes/modern-warfare-2.json; change those, not this file.
# Use, in ~/.gitconfig:
#   [include]
#       path = /path/to/extras/modern-warfare-2/delta.gitconfig
#   [delta]
#       features = modern-warfare-2
# syntax-theme is the bat theme from bat.tmTheme, installed as svoboden-modern-warfare-2 (delta reads bat's cache).
[delta "modern-warfare-2"]
    dark = true
    syntax-theme = svoboden-modern-warfare-2
    minus-style = syntax "#3b201c"
    minus-emph-style = syntax "#672e2a"
    plus-style = syntax "#272f16"
    plus-emph-style = syntax "#3b4e1d"
    zero-style = syntax
    whitespace-error-style = "#d9534f" reverse
    file-style = "#98d538" bold
    file-decoration-style = "#98d538" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#5c5a52" box
    hunk-header-file-style = "#2d9485"
    hunk-header-line-number-style = "#98d538"
    commit-decoration-style = "#98d538" box ul
    line-numbers-minus-style = "#d9534f"
    line-numbers-plus-style = "#7bad35"
    line-numbers-zero-style = "#5c5a52"
    line-numbers-left-style = "#3f3d39"
    line-numbers-right-style = "#3f3d39"
